# Binance Futures API Configuration
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
BINANCE_FUTURES_WS_URL=wss://fstream.binance.com/ws
BINANCE_FUTURES_API_KEY=your_binance_api_key_here
BINANCE_FUTURES_SECRET_KEY=your_binance_api_secret_here

# Testnet Configuration ( uncomment for testing)
# BINANCE_FUTURES_BASE_URL=https://testnet.binancefuture.com
# BINANCE_FUTURES_WS_URL=wss://stream.binancefuture.com/ws

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trading_db
POSTGRES_USER=trading
POSTGRES_PASSWORD=trading_secure_pass

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Risk Management
MAX_POSITION_SIZE_PERCENT=2
MAX_TOTAL_OPEN_RISK_PERCENT=10
MAX_DAILY_LOSS_PERCENT=5
STOP_LOSS_BUFFER_ATR=2

# Trading Configuration
DEFAULT_RISK_REWARD_RATIO=2
MIN_RISK_REWARD_RATIO=1.5
MAX_CORRELATED_POSITIONS=1
TRADING_ENABLED=false
PAPER_TRADING=true
LEVERAGE=5

# Telegram Bot Configuration (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Discord Bot Configuration (Optional)
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=your_discord_channel_id_here

# News API Configuration (Optional but Recommended)
# Get API key from: https://cryptopanic.com/developers/api/
# Plans: developer (free), growth, enterprise
CRYPTOPANIC_API_KEY=your_cryptopanic_api_key_here
CRYPTOPANIC_API_PLAN=developer
NEWS_CHECK_ENABLED=true

# Application Configuration
NODE_ENV=development
LOG_LEVEL=info
SERVER_PORT=3000

# Security
API_WHITELIST_IP=127.0.0.1,localhost
ENABLE_KILL_SWITCH=true

# Binance Specific
DEFAULT_MARGIN_TYPE=CROSS
DEFAULT_POSITION_MODE=HEDGE
ORDER_REPLY_TIMEOUT=5000
MAX_RETRIES=3
